LLM_PROVIDER=nvidia
ANALYSIS_MODE=queue
# Set this to the deployed frontend origin, without a trailing slash.
CORS_ORIGIN=
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
NVIDIA_NIM_TIMEOUT_MS=45000

# For local Node, use localhost and your PostgreSQL credentials; postgres is the Docker Compose hostname.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dev
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=2
