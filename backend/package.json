{
  "name": "ai-bug-tracker-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "serve": "node src/server.js",
    "start": "npm run migrate && npm run serve",
    "start:local": "node --env-file=.env src/db/migrate.js && node --env-file=.env src/server.js",
    "dev": "npm run migrate && nodemon src/server.js",
    "worker:run": "node src/worker.js",
    "worker": "npm run migrate && npm run worker:run",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bullmq": "^1.71.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
